# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca coloque valores reais neste arquivo: ele vai para o Git.

# --- Site (Next.js) -------------------------------------------------------
# Painel do Supabase → Project Settings → API Keys.
SUPABASE_URL=
# Chave publicável (sb_publishable_...): só leitura, protegida pelo RLS.
# Usada só no servidor do Next.js.
SUPABASE_PUBLISHABLE_KEY=

# --- Rotinas de coleta (pipeline/) ----------------------------------------
# ID do projeto (Project Settings → General).
SUPABASE_PROJECT_REF=
# Endereço do pooler em modo sessão (botão "Connect" → Session pooler),
# ex.: aws-0-sa-east-1.pooler.supabase.com
COLETA_DB_HOST=
# Senha do usuário "coleta". NÃO preencha à mão: gere com
#   python pipeline/definir_senha_coleta.py
COLETA_DB_PASSWORD=
