# Copie este arquivo para .env.local e preencha com os valores reais.
# Nunca coloque valores reais neste arquivo: ele vai para o Git.

# Supabase (Painel do Supabase → Project Settings → API)
SUPABASE_URL=
# Chave pública de leitura. Usada só no servidor do Next.js.
SUPABASE_ANON_KEY=
# Chave com permissão de escrita. Usada SÓ nas rotinas de coleta de dados
# (GitHub Actions). Nunca no site.
SUPABASE_SERVICE_ROLE_KEY=
